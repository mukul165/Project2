# Local .terraform directories
**/.terraform/*

# Terraform state files — these can contain secrets, never commit them
# (we use a remote GCS backend, so these should never even be created,
# but ignore them as a safety net)
*.tfstate
*.tfstate.*
*.tfstate.backup

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which usually contain sensitive data
*.tfvars
*.tfvars.json
!example.tfvars

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore lock file differences across OSes (optional — many teams DO commit this)
# .terraform.lock.hcl

# OS/editor junk
.DS_Store
*.swp